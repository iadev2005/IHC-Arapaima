    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.3",
    "shadcn": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
